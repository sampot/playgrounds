{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "playgrounds-go",
  "compatibility_date": "2026-08-07",
  "main": "./src/worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  // Pure-play Guest SPA (DEC-050) — not a field shell.
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // `/index.html` is the prerendered home page. Dynamic Invite routes need
    // SvelteKit's client fallback (`/200.html`) instead.
    "run_worker_first": [
      "/i",
      "/i/*",
      "/room-file",
      "/room-file/*",
      "/room-play",
      "/room-play/*"
    ]
  },
  "routes": [
    {
      "pattern": "go.samkuo.me",
      "custom_domain": true
    }
    // Zone route `go.samkuo.me/*` → this Worker may need dashboard setup
    // so field-net `*.samkuo.me/*` does not swallow go.
  ]
}
