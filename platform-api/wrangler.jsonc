{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "playgrounds-platform-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dash/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "STORE",
      "id": "8376c6427d3b4e1da440ed4960facbe1",
      "preview_id": "c4ecea2b245c439ea9eafa738169e0aa"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INVITES",
        "class_name": "InviteDurableObject"
      },
      {
        "name": "BOOTH_ANCHORS",
        "class_name": "BoothAnchorDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InviteDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BoothAnchorDurableObject"]
    }
  ],
  "routes": [
    {
      "pattern": "api.samkuo.me",
      "custom_domain": true
    },
    {
      "pattern": "dash.samkuo.me",
      "custom_domain": true
    }
  ]
}
