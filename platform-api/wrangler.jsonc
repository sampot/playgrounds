{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "playgrounds-platform-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": true,
  "kv_namespaces": [
    {
      "binding": "STORE",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INVITES",
        "class_name": "InviteDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["InviteDurableObject"]
    }
  ]
}
