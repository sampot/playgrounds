{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "playgrounds",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Hostname reserved check must run before asset SPA fallback.
    "run_worker_first": true
  },
  // Wildcard catches docs too — forward via service binding (see src/worker.ts).
  "services": [
    {
      "binding": "DOCS",
      "service": "playgrounds-docs"
    }
  ],
  "routes": [
    {
      "pattern": "play.samkuo.me",
      "custom_domain": true
    },
    {
      "pattern": "*.samkuo.me/*",
      "zone_name": "samkuo.me"
    }
  ]
}
