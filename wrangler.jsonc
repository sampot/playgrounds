{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Single-site self-host (Deploy to Cloudflare button / wrangler deploy).
  // Official play.samkuo.me field-net: wrangler.official.jsonc
  "name": "playgrounds",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
