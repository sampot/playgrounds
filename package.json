{
  "name": "playgrounds",
  "version": "0.1.0",
  "private": false,
  "description": "Browser Playgrounds host: SAM sandboxes, OPFS, agents, WASI shell",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "catalog:gen": "node --experimental-strip-types --experimental-transform-types scripts/generate-catalog.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync || echo ''",
    "build": "npm run catalog:gen && npm run check && vite build",
    "pretest": "svelte-kit sync && npm run catalog:gen",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:official": "npm run build && wrangler deploy -c wrangler.official.jsonc",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "deploy:official:dry": "npm run build && wrangler deploy -c wrangler.official.jsonc --dry-run",
    "docs:dev": "npm run dev --prefix docs-site",
    "docs:build": "npm run build --prefix docs-site",
    "docs:deploy": "npm run deploy --prefix docs-site",
    "docs:deploy:dry": "npm run deploy:dry --prefix docs-site",
    "platform:dev": "npm run dev --prefix platform-api",
    "platform:test": "npm test --prefix platform-api",
    "platform:deploy": "npm run deploy --prefix platform-api",
    "go:dev": "npm run dev --prefix go-client",
    "go:build": "npm run build --prefix go-client",
    "go:check": "npm run check --prefix go-client",
    "go:deploy": "npm run deploy --prefix go-client",
    "go:deploy:dry": "npm run deploy:dry --prefix go-client",
    "test": "vitest run",
    "test:watch": "vitest",
    "sam-host": "node --experimental-strip-types --experimental-transform-types src/sam-host/node/cli.ts",
    "sdk:check": "node --experimental-strip-types scripts/sdk-static-check.ts",
    "sdk:test": "vitest run defaultFunctionsHandler"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "qr": "^0.6.0",
    "sql.js": "^1.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.53.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/sql.js": "^1.4.11",
    "svelte": "^5.56.8",
    "svelte-check": "^4.4.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "engines": {
    "node": ">=24"
  }
}
