---
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** App shell (OPFS UI) vs scrollable content page (e.g. `/sam/`). */
  variant?: "app" | "page";
  /** Path under site origin, e.g. `/sam/og.png`. Defaults to `/og.png`. */
  ogImage?: string;
  /** Default noindex for the field app; catalog may opt into indexing. */
  robots?: string;
  /** Highlight host-header nav item. */
  activeNav?: "field" | "sam" | "docs";
}

const {
  title = "遊樂場 · 我是山姆鍋",
  description = "我是山姆鍋的瀏覽器遊樂場：開發與實驗單頁小程式（SAM）；沙盒存於 OPFS。",
  variant = "app",
  ogImage = "/og.png",
  robots = "noindex, follow",
  activeNav = "field",
} = Astro.props;

const site = Astro.site ?? new URL("https://play.samkuo.me");
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;
const isPage = variant === "page";
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8faf9" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="我是山姆鍋" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <!-- Same contract as blog Layout: localStorage theme / font-size → html data-* -->
    <script is:inline src="/toggle-theme.js?v=4"></script>
    <script is:inline src="/toggle-font-size.js?v=3"></script>
  </head>
  <body>
    <div class:list={["playgrounds-page", isPage && "playgrounds-page--scroll"]}>
      <header
        class="playgrounds-host-header border-skin-line text-skin-base/70 flex shrink-0 items-center gap-3 border-b px-3 py-1.5 text-xs"
      >
        <div class="playgrounds-host-brand flex min-w-0 items-center gap-2">
          <a
            class="text-skin-base/80 flex min-w-0 items-center gap-2 no-underline"
            href="https://samkuo.me/"
            rel="noopener noreferrer"
            aria-label="我是山姆鍋"
          >
            <img
              class="playgrounds-host-logo"
              src="/favicon.svg"
              alt=""
              width="20"
              height="20"
              decoding="async"
            />
            <span>我是山姆鍋</span>
          </a>
          <span class="text-skin-base/40" aria-hidden="true">·</span>
          <a
            class:list={[
              "no-underline",
              activeNav === "field"
                ? "text-skin-base font-medium"
                : "text-skin-base/80",
            ]}
            href="/"
            aria-label="遊樂場首頁"
            aria-current={activeNav === "field" ? "page" : undefined}>遊樂場</a
          >
          <span class="text-skin-base/40" aria-hidden="true">·</span>
          <a
            class:list={[
              "no-underline",
              activeNav === "sam"
                ? "text-skin-base font-medium"
                : "text-skin-base/80",
            ]}
            href="/sam/"
            aria-current={activeNav === "sam" ? "page" : undefined}>小品</a
          >
          <span class="text-skin-base/40" aria-hidden="true">·</span>
          <a
            class:list={[
              "no-underline",
              activeNav === "docs"
                ? "text-skin-base font-medium"
                : "text-skin-base/80",
            ]}
            href="https://docs.samkuo.me/"
            rel="noopener noreferrer"
            aria-current={activeNav === "docs" ? "page" : undefined}>文件</a
          >
        </div>
      </header>
      <main
        id="main-content"
        class:list={[
          isPage ? "playgrounds-page-main" : "app-shell playgrounds-main",
        ]}
      >
        <slot />
      </main>
    </div>
  </body>
</html>
