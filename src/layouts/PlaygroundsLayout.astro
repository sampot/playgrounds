---
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "遊樂場 · 我是山姆鍋",
  description = "我是山姆鍋的瀏覽器遊樂場：開發與實驗單頁小程式（SAM）；沙盒存於 OPFS。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8faf9" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Same contract as blog Layout: localStorage theme / font-size → html data-* -->
    <script is:inline src="/toggle-theme.js?v=4"></script>
    <script is:inline src="/toggle-font-size.js?v=3"></script>
  </head>
  <body>
    <div class="playgrounds-page">
      <header
        class="playgrounds-host-header border-skin-line text-skin-base/70 flex shrink-0 items-center justify-between gap-3 border-b px-3 py-1.5 text-xs"
      >
        <div class="playgrounds-host-brand flex min-w-0 items-center gap-2">
          <a
            class="text-skin-base/80 flex min-w-0 items-center gap-2 no-underline"
            href="https://samkuo.me/"
            rel="noopener noreferrer"
            aria-label="我是山姆鍋"
          >
            <img
              class="playgrounds-host-logo"
              src="/favicon.svg"
              alt=""
              width="20"
              height="20"
              decoding="async"
            />
            <span>我是山姆鍋</span>
          </a>
          <span class="text-skin-base/40" aria-hidden="true">·</span>
          <a
            class="text-skin-base/80 no-underline"
            href="/"
            aria-label="遊樂場首頁">遊樂場</a
          >
        </div>
        <a
          class="text-skin-accent underline decoration-dashed underline-offset-2"
          href="https://docs.samkuo.me/"
          rel="noopener noreferrer">文件</a
        >
      </header>
      <main id="main-content" class="app-shell playgrounds-main">
        <slot />
      </main>
    </div>
  </body>
</html>
